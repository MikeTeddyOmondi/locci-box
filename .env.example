# ── API Server ────────────────────────────────────────────────────────────────
PORT=5757
NODE_ENV=development

# Admin key for /metrics endpoint  (openssl rand -base64 18)
ADMIN_API_KEY=admin_your_secret_key_here

# JWT secret for web-app authentication  (openssl rand -base64 32)
JWT_SECRET=locci-box-dev-secret-change-in-production

# Default tenant rate limits
DEFAULT_MAX_CONCURRENT_SANDBOXES=5
DEFAULT_SANDBOX_TIMEOUT_SECONDS=30
DEFAULT_RATE_LIMIT_PER_MINUTE=60

# Logging
LOG_LEVEL=info

# Database mode: pglite (dev/embedded, zero setup) or postgresql (production)
DATABASE_MODE=pglite

# PGLite database path — used when DATABASE_MODE=pglite (created automatically on first run)
# In Docker this is overridden to /app/data/locci-box (volume-mounted for persistence)
DB_PATH=./data/locci-box

# PostgreSQL connection string — required when DATABASE_MODE=postgresql
# DATABASE_URL=postgresql://locci:password@localhost:5432/loccibox

# PostgreSQL password for the postgres service in compose.yaml (prod-db profile)
# POSTGRES_PASSWORD=your_secure_password_here

# ── JuiceFS Persistent Volumes ────────────────────────────────────────────────
# Set JFS_ENABLED=true to give each sandbox a persistent /workspace volume
# backed by JuiceFS → Redis (metadata) + an external S3-compatible store (data).
# Requires starting with: docker compose --profile jfs up -d
JFS_ENABLED=false
JFS_ROOT=/mnt/locci-box
JFS_QUOTA_MIB=512
# Metadata engine for the juicefs CLI helper scripts (pnpm jfs:*). Redis/Valkey in
# dev; swap to tikv://… for production HA. Not consumed by the app at runtime.
JFS_META_URL=redis://127.0.0.1:6379/2

# External S3-compatible endpoint for JuiceFS data blocks (e.g. RustFS / MinIO).
# RUSTFS_ENDPOINT must be a full URL including scheme.
RUSTFS_ENDPOINT=http://rustfs:9000
RUSTFS_ACCESS_KEY=your_s3_access_key_here
RUSTFS_SECRET_KEY=your_s3_secret_key_here
JFS_BUCKET=locci-box

# MCP Server
# MCP_ENABLED=true  — controls the standalone stdio server (pnpm mcp:dev / loccibox mcp start)
MCP_ENABLED=true
# MCP_HTTP_ENABLED=true — mounts POST /mcp on the main API (same port, same Docker container)
MCP_HTTP_ENABLED=false
# MCP_HTTP_PORT — port for the standalone mcp:dev server only (not used in production)
MCP_HTTP_PORT=3001

# ── AI (BOB code-review assistant) ───────────────────────────────────────────
# Get a key at https://console.groq.com
GROQ_API_KEY=gsk_your_groq_api_key_here

# ── Web App (web/.env or Docker build args) ───────────────────────────────────
# URL of the API that the browser talks to
VITE_API_URL=http://localhost:5757

# ── Docker Compose overrides ──────────────────────────────────────────────────
# Port the web preview server is exposed on (default 4173)
WEB_PORT=4173

# URL the CLI container uses to reach the API service (use service name in Docker)
LOCCIBOX_API_URL=http://api:5757