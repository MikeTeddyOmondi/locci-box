# ── API Server ────────────────────────────────────────────────────────────────
PORT=5757
NODE_ENV=development

# Admin key for /metrics endpoint  (openssl rand -base64 18)
ADMIN_API_KEY=admin_your_secret_key_here

# JWT secret for web-app authentication  (openssl rand -base64 32)
JWT_SECRET=locci-box-dev-secret-change-in-production

# Default tenant rate limits
DEFAULT_MAX_CONCURRENT_SANDBOXES=5
DEFAULT_SANDBOX_TIMEOUT_SECONDS=30
DEFAULT_RATE_LIMIT_PER_MINUTE=60

# Logging
LOG_LEVEL=info

# PGlite embedded database path (created automatically on first run)
# In Docker this is overridden to /app/data/locci-box (volume-mounted for persistence)
DB_PATH=./data/locci-box

# MCP Server
MCP_ENABLED=true

# ── Web App (web/.env or Docker build args) ───────────────────────────────────
# URL of the API that the browser talks to
VITE_API_URL=http://localhost:5757

# ── Docker Compose overrides ──────────────────────────────────────────────────
# Port the web preview server is exposed on (default 4173)
WEB_PORT=4173

# URL the CLI container uses to reach the API service (use service name in Docker)
LOCCIBOX_API_URL=http://api:5757