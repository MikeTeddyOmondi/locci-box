{
  "name": "@loccibox/cli",
  "version": "1.1.0",
  "description": "CLI for Locci Box - Execute code in isolated sandboxes",
  "type": "module",
  "bin": {
    "loccibox": "./dist/index.js"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
