{
  "name": "@locci/box-api",
  "version": "1.2.1",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:web": "pnpm --filter @locci/box-web dev",
    "dev:all": "concurrently \"pnpm dev\" \"pnpm dev:web\"",
    "build": "tsc",
    "build:web": "pnpm --filter @locci/box-web build",
    "build:all": "pnpm build && pnpm build:web",
    "start": "node dist/server.js",
    "mcp": "node dist/mcp/server.js",
    "mcp:dev": "MCP_ENABLED=true tsx src/mcp/server.ts",
    "mcp:inspect": "MCP_ENABLED=true npx -y @modelcontextprotocol/inspector tsx src/mcp/server.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:web": "pnpm --filter @locci/box-web format",
    "format:all": "pnpm format && pnpm format:web",
    "lint": "pnpm --filter @locci/box-web lint",
    "lint:all": "pnpm lint",
    "docker:api": "pnpm build && docker build -t locci/box-api -f Dockerfile .",
    "docker:web": "docker build -t locci/box-web -f web/Dockerfile .",
    "docker:cli": "docker build -t locci/box-cli -f cli/Dockerfile .",
    "docker:build": "pnpm docker:api && pnpm docker:web && pnpm docker:cli",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.4.5",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.3",
    "microsandbox": "^0.4.6",
    "nanoid": "^5.0.3",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "valibot": "^1.4.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "microsandbox",
      "@superradcompany/microsandbox-linux-x64-gnu",
      "@superradcompany/microsandbox-linux-arm64-gnu",
      "@superradcompany/microsandbox-darwin-arm64"
    ]
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.7.10",
    "@types/supertest": "^7.2.0",
    "@vitest/coverage-v8": "^4.1.6",
    "concurrently": "^9.1.2",
    "drizzle-kit": "^0.31.10",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.8.3",
    "supertest": "^7.2.2",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "vitest": "^4.1.6"
  }
}
