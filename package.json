{
  "name": "locci-box",
  "version": "1.0.0",
  "type": "module",
  "description": "B2B API for safe code execution in isolated microVMs",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "mcp": "node dist/mcp/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [
    "sandbox",
    "microvm",
    "b2b",
    "api"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^4.18.2",
    "microsandbox": "^0.4.6",
    "nanoid": "^5.0.3",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "valibot": "^1.4.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.7.10",
    "@vitest/coverage-v8": "^4.1.6",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "vitest": "^4.1.6"
  }
}
