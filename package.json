{
  "name": "@locci-box/api",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:web": "pnpm --filter @locci-box/web dev",
    "dev:all": "concurrently \"pnpm dev\" \"pnpm dev:web\"",
    "build": "tsc",
    "build:web": "pnpm --filter @locci-box/web build",
    "build:all": "pnpm build && pnpm build:web",
    "start": "node dist/server.js",
    "mcp": "node dist/mcp/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:web": "pnpm --filter @locci-box/web format",
    "format:all": "pnpm format && pnpm format:web",
    "lint": "pnpm --filter @locci-box/web lint",
    "lint:all": "pnpm lint"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.3",
    "microsandbox": "^0.4.6",
    "nanoid": "^5.0.3",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "valibot": "^1.4.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.7.10",
    "@vitest/coverage-v8": "^4.1.6",
    "concurrently": "^9.1.2",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.8.3",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "vitest": "^4.1.6"
  }
}
