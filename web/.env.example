# Locci Auth, the OpenAuth issuer locci-platform signs in with (same names as locci-platform)
PUBLIC_OPENAUTH_ISSUER=http://localhost:8787
PUBLIC_OPENAUTH_CLIENT_ID=locci-box
# Only when this server cannot reach PUBLIC_OPENAUTH_ISSUER at that address (a container)
# LOCCI_AUTH_INTERNAL_ORIGIN=http://host.docker.internal:8787

# Where this server reaches the Locci Box API, and the address shown to people in examples
LOCCI_BOX_API_URL=http://localhost:5757
PUBLIC_LOCCI_BOX_API_URL=http://localhost:5757
