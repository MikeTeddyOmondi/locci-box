{
	"name": "@locci/box-web",
	"version": "2.0.0",
	"private": true,
	"description": "Locci Box console: a SvelteKit client of the Locci Box API",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --threshold error",
		"start": "node build"
	},
	"dependencies": {
		"@ai-sdk/svelte": "4.0.316",
		"@lucide/svelte": "1.52.0",
		"@openauthjs/openauth": "0.4.3",
		"ai": "6.0.316",
		"bits-ui": "2.19.5",
		"clsx": "2.1.1",
		"dompurify": "3.4.16",
		"marked": "17.0.1",
		"mode-watcher": "1.1.0",
		"monaco-editor": "0.57.0",
		"shiki": "4.5.0",
		"svelte-sonner": "1.2.2",
		"tailwind-merge": "3.7.0",
		"tailwind-variants": "3.3.1",
		"valibot": "1.2.0"
	},
	"devDependencies": {
		"@sveltejs/adapter-node": "5.5.4",
		"@sveltejs/kit": "2.70.3",
		"@sveltejs/vite-plugin-svelte": "6.2.4",
		"@tailwindcss/forms": "0.5.11",
		"@tailwindcss/typography": "0.5.20",
		"@tailwindcss/vite": "4.3.3",
		"@types/dompurify": "3.2.0",
		"shadcn-svelte": "1.7.0",
		"svelte": "5.57.2",
		"svelte-check": "4.7.6",
		"tailwindcss": "4.3.3",
		"tw-animate-css": "1.4.0",
		"typescript": "5.9.3",
		"vite": "7.3.7"
	}
}
